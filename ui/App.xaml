<Application x:Class="CMP90HX.Control.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- All surface backgrounds share this opacity: 0 = transparent, 1 = opaque. -->
        <sys:Double x:Key="SurfaceOpacity">0.82</sys:Double>
        <SolidColorBrush x:Key="WhiteSurfaceBrush" Color="White"
                         Opacity="{StaticResource SurfaceOpacity}" />
        <SolidColorBrush x:Key="LogSurfaceBrush" Color="#101A2A"
                         Opacity="{StaticResource SurfaceOpacity}" />
        <ImageBrush x:Key="WindowBackgroundBrush" ImageSource="/CMP90HXControl;component/background.jpg"
                    Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
    </Application.Resources>
</Application>
